# Web Search RAG
WEB_RAG_SEARCH_PROVIDER=tavily
WEB_RAG_SEARCH_URL=https://api.tavily.com/search
WEB_RAG_USER_AGENT=SKN27-MapleStory-WebRAG/0.1
WEB_RAG_TIMEOUT_SECONDS=10
WEB_RAG_MAX_RESULTS=5
WEB_RAG_MAX_CONTEXTS=5
WEB_RAG_OFFICIAL_DOMAINS=maplestory.nexon.com,openapi.nexon.com,notice.nexon.com
WEB_RAG_COMMUNITY_DOMAINS=maple.inven.co.kr,www.inven.co.kr

# Tavily Search API
TAVILY_API_KEY=your-tavily-api-key
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_RAW_CONTENT=false

